      "credentials": [{ "type": "password", "value": "demo-junta", "temporary": false }]
    },
    {
      "username": "admin.demo",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.demo@example.test",
      "firstName": "Admin",
      "lastName": "Demostración",
      "attributes": {
        "colegiado": ["ICAT-9999"],
        "abogado_id": ["00000000-0000-4000-8000-000000000204"]
