{
  "realm": "tof",
  "displayName": "Turno de Oficio",
  "displayNameHtml": "<strong>Turno de Oficio</strong> · Colegio de Abogados",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(8)",
  "roles": {
    "realm": [
      {
        "name": "letrado",
        "description": "Letrado de guardia: consulta su cuadrante, acusa y presenta solicitudes"
      },
      {
        "name": "coordinacion",
        "description": "Coordinación: planifica, designa, resuelve solicitudes y publica el cuadrante"
      },
      {
        "name": "junta",
        "description": "Junta de Gobierno: lectura de cuadrantes, equidad y exportaciones"
      },
      {
        "name": "admin",
        "description": "Administración técnica: parámetros, catálogos y usuarios"
      }
    ]
  },
  "groups": [
    { "name": "letrados", "path": "/letrados", "realmRoles": ["letrado"] },
    { "name": "coordinacion", "path": "/coordinacion", "realmRoles": ["coordinacion"] },
    { "name": "junta", "path": "/junta", "realmRoles": ["junta"] },
    { "name": "administracion", "path": "/administracion", "realmRoles": ["admin"] }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000101",
      "username": "letrado.demo",
      "enabled": true,
      "emailVerified": true,
      "email": "letrado.demo@example.test",
      "firstName": "Lucía",
      "lastName": "Demostración",
      "attributes": {
        "colegiado": ["ICAT-0101"],
        "abogado_id": ["00000000-0000-4000-8000-000000000201"]
      },
      "groups": ["/letrados"],
      "credentials": [{ "type": "password", "value": "demo-letrado", "temporary": false }]
    },
    {
      "username": "coordinacion.demo",
      "enabled": true,
      "emailVerified": true,
      "email": "coordinacion.demo@example.test",
      "firstName": "Marta",
      "lastName": "Demostración",
      "attributes": {
        "colegiado": ["ICAT-0001"],
        "abogado_id": ["00000000-0000-4000-8000-000000000202"]
      },
      "groups": ["/coordinacion"],
      "credentials": [{ "type": "password", "value": "demo-coordinacion", "temporary": false }]
    },
    {
      "username": "junta.demo",
      "enabled": true,
      "emailVerified": true,
      "email": "junta.demo@example.test",
