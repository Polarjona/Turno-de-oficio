# Copiar a .env (no se versiona) y ajustar lo que choque con la máquina.
# Todos los valores tienen el mismo equivalente por defecto en
# docker/docker-compose.yml, así que sin .env el stack también arranca.

# --- Postgres ---
POSTGRES_USER=turno
POSTGRES_PASSWORD=turno
POSTGRES_DB=turno
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# La API se conecta por PgBouncer, no directo a Postgres.
DATABASE_URL=postgres://turno:turno@localhost:6432/turno

# --- Keycloak ---
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=tof
KEYCLOAK_URL=http://localhost:8081

# --- Correo (Mailpit: SMTP 1025, interfaz 8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_PORT=8025

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=turno

# --- Observabilidad ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
GRAFANA_ADMIN_PASSWORD=admin

# --- SharePoint (Microsoft Graph) ---
# Vacío = MockSharePointClient, que escribe en ./tmp/sharepoint.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Turno de Oficio
