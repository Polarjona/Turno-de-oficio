{
  "name": "turno-de-oficio",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestión de guardias del Turno de Oficio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "npm run build -w @turno/shared",
    "postinstall": "npm run build:shared",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @turno/api",
    "dev:web": "npm run dev -w @turno/web",
    "openapi": "npm run openapi -w @turno/api && node scripts/check-contrato.mjs",
    "check:ddl": "node scripts/check-ddl.mjs",
    "migrar": "node scripts/migrar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  }
}
