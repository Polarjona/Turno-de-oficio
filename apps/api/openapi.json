{
  "openapi": "3.0.0",
  "info": {
    "title": "Turno de Oficio · API",
    "description": "Contrato generado desde el código",
    "version": "0.1.0",
    "contact": {}
  },
  "paths": {
    "/guardias": {
      "get": {
        "operationId": "GuardiasController_listar",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Cursor opaco de la página anterior",
            "schema": {}
          },
          {
            "name": "limite",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "orden",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "fecha_asc",
                "fecha_desc"
              ],
              "default": "fecha_asc"
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "description": "Repetible: estado=planificada&estado=publicada",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "hasta",
            "required": false,
            "in": "query",
            "description": "Fecha final inclusive (AAAA-MM-DD)",
            "schema": {}
          },
          {
            "name": "desde",
            "required": false,
            "in": "query",
            "description": "Fecha inicial inclusive (AAAA-MM-DD)",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Página de guardias"
          },
          "400": {
            "description": "Filtro o cursor inválido"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Guardias del periodo con filtros",
        "tags": [
          "guardias"
        ]
      },
      "post": {
        "operationId": "GuardiasController_crear",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Guardia creada en estado planificada"
          },
          "400": {
            "description": "El cuerpo no cumple GuardiaRequest"
          },
          "403": {
            "description": "El rol no permite crear guardias"
          },
          "409": {
            "description": "Ya existe una guardia de ese tipo en esa fecha"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crea una franja sin titular (estado planificada)",
        "tags": [
          "guardias"
        ]
      }
    },
    "/guardias/{guardiaId}": {
      "get": {
        "operationId": "GuardiasController_detalle",
        "parameters": [
          {
            "name": "guardiaId",
            "required": true,
            "in": "path",
            "description": "Identificador de la guardia",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Guardia encontrada",
            "headers": {
              "ETag": {
                "description": "Versión del recurso",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "La guardia no existe"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalle de una guardia",
        "tags": [
          "guardias"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_actual",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Datos del usuario autenticado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Usuario de la sesión",
        "tags": [
          "sesion"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {}
  }
}
