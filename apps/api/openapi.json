{
  "openapi": "3.0.0",
  "info": {
    "title": "Turno de Oficio · API",
    "description": "Contrato generado desde el código",
    "version": "0.1.0",
    "contact": {}
  },
  "paths": {
    "/guardias": {
      "get": {
        "operationId": "GuardiasController_listar",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Cursor opaco de la página anterior",
            "schema": {}
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "orden",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "fecha_asc",
                "fecha_desc"
              ],
              "default": "fecha_asc"
            }
          },
          {
            "name": "solo_detenido",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Franjas de asistencia al detenido (RN-35)"
          },
          {
            "name": "solo_descubiertas",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "abogado_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Si no se indica y el rol es letrado, se fuerza al propio"
          },
          {
            "name": "tipo_guardia_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "especialidad_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "description": "Repetible: estado=planificada&estado=publicada",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "hasta",
            "required": false,
            "in": "query",
            "description": "Fecha final inclusive (AAAA-MM-DD)",
            "schema": {}
          },
          {
            "name": "desde",
            "required": false,
            "in": "query",
            "description": "Fecha inicial inclusive (AAAA-MM-DD)",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Página de guardias",
            "headers": {
              "X-Total-Estimado": {
                "description": "Guardias que cumplen los filtros",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Filtro o cursor inválido"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Guardias del periodo con filtros",
        "tags": [
          "guardias"
        ]
      },
      "post": {
        "operationId": "GuardiasController_crear",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Guardia creada en estado planificada"
          },
          "400": {
            "description": "El cuerpo no cumple GuardiaRequest"
          },
          "403": {
            "description": "El rol no permite crear guardias"
          },
          "409": {
            "description": "Ya existe una guardia de ese tipo en esa fecha"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crea una franja sin titular (estado planificada)",
        "tags": [
          "guardias"
        ]
      }
    },
    "/guardias/{guardiaId}": {
      "get": {
        "operationId": "GuardiasController_detalle",
        "parameters": [
          {
            "name": "guardiaId",
            "required": true,
            "in": "path",
            "description": "Identificador de la guardia",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Guardia encontrada",
            "headers": {
              "ETag": {
                "description": "Versión del recurso",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "La guardia no existe"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalle de una guardia",
        "tags": [
          "guardias"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_actual",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Datos del usuario autenticado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Usuario de la sesión",
        "tags": [
          "sesion"
        ]
      }
    },
    "/solicitudes": {
      "get": {
        "operationId": "SolicitudesController_listar",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Cursor opaco de la página anterior",
            "schema": {}
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "solo_vencidas",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "solicitante_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "guardia_id",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "excusa",
                "permuta",
                "sustitucion"
              ]
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "description": "Repetible: estado=comunicada&estado=en_revision",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de solicitudes"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Excusas, permutas y sustituciones",
        "tags": [
          "solicitudes"
        ]
      },
      "post": {
        "operationId": "SolicitudesController_crear",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Solicitud registrada"
          },
          "400": {
            "description": "El cuerpo no cumple SolicitudRequest"
          },
          "403": {
            "description": "Solo el letrado titular presenta solicitudes"
          },
          "404": {
            "description": "La guardia no existe"
          },
          "409": {
            "description": "La guardia ya tiene una solicitud abierta"
          },
          "422": {
            "description": "Regla de negocio: excusa fuera del orden penal"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Registra excusa, permuta o sustitución",
        "tags": [
          "solicitudes"
        ]
      }
    },
    "/solicitudes/{solicitudId}": {
      "get": {
        "operationId": "SolicitudesController_detalle",
        "parameters": [
          {
            "name": "solicitudId",
            "required": true,
            "in": "path",
            "description": "Identificador de la solicitud",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud encontrada"
          },
          "404": {
            "description": "La solicitud no existe"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalle de una solicitud",
        "tags": [
          "solicitudes"
        ]
      }
    },
    "/solicitudes/{solicitudId}/resolucion": {
      "post": {
        "operationId": "SolicitudesController_resolver",
        "parameters": [
          {
            "name": "solicitudId",
            "required": true,
            "in": "path",
            "description": "Identificador de la solicitud",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud resuelta"
          },
          "400": {
            "description": "Falta la decisión o el motivo de la resolución"
          },
          "403": {
            "description": "El rol no puede resolver solicitudes"
          },
          "409": {
            "description": "La solicitud ya estaba resuelta"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Resuelve la solicitud con motivación obligatoria",
        "tags": [
          "solicitudes"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {}
  }
}
